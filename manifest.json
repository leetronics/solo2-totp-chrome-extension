{
  "manifest_version": 3,
  "name": "SoloKeys Vault",
  "version": "1.0.0",
  "key": "",
  "description": "Password manager with TOTP support for SoloKeys 2 security keys",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/new-logo-16.png",
      "48": "icons/new-logo-48.png",
      "128": "icons/new-logo-128.png"
    },
    "theme_icons": [
      {
        "dark": "icons/new-logo-16.png",
        "light": "icons/new-logo-16.png",
        "size": 16
      },
      {
        "dark": "icons/new-logo-48.png",
        "light": "icons/new-logo-48.png",
        "size": 48
      },
      {
        "dark": "icons/new-logo-128.png",
        "light": "icons/new-logo-128.png",
        "size": 128
      }
    ]
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/new-logo-16.png",
    "48": "icons/new-logo-48.png",
    "128": "icons/new-logo-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ]
}
